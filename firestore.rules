rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'aryangandhale27@gmail.com' ||
        request.auth.token.email == 'admin@semixlabs.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isStaff() {
      return isSignedIn() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'team', 'seller'])
      );
    }

    function isTeam() {
      return isAdmin() || (isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'team');
    }

    function isSeller() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'seller';
    }

    // Default Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Test Connection Path (for SDK initialization ping)
    match /test/{docId} {
      allow read, write: if true;
    }

    // Products Collection: Public read & team/admin catalog management
    match /products/{productId} {
      allow read: if true;
      allow create: if isAdmin() || isTeam() || (isSeller() && request.resource.data.sellerId == request.auth.uid);
      allow update: if isAdmin() || isTeam() || (isSeller() && resource.data.sellerId == request.auth.uid && request.resource.data.sellerId == request.auth.uid);
      allow delete: if isAdmin() || isTeam() || (isSeller() && resource.data.sellerId == request.auth.uid);
    }

    match /components/{componentId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() || isTeam();
    }

    // Orders Collection: Customer reads own orders or guest creation, staff/seller access
    match /orders/{orderId} {
      allow read: if isAdmin() || isTeam() || (isSignedIn() && resource.data.userId == request.auth.uid) || (isSeller() && resource.data.assignedSellerId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin() || isTeam() || (isSeller() && resource.data.assignedSellerId == request.auth.uid && request.resource.data.assignedSellerId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // User Profiles: Public registration create, owner & staff/admin read/update
    match /users/{userId} {
      allow read: if isOwner(userId) || isStaff();
      allow create: if isOwner(userId) || isAdmin();
      allow update: if isOwner(userId) || isStaff() || isAdmin();
      allow delete: if isAdmin();
    }

    // Custom Project Requests
    match /customProjects/{projectId} {
      allow read: if isAdmin() || isTeam() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin() || isTeam() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /bulk_enquiries/{enquiryId} {
      allow read: if isStaff() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isStaff() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow delete: if isStaff();
    }

    match /staff/{staffId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // Coupons and Usage Tracking
    match /coupons/{couponCode} {
      // Public read for customer validation at checkout, admin/staff full management
      allow read: if isSignedIn();
      // Allow write for admins and for checkout atomic transaction incrementing timesUsed
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isSignedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['timesUsed', 'updatedAt']));

      // Subcollection: coupons/{couponCode}/usages/{userId}
      match /usages/{userId} {
        allow read: if isOwner(userId) || isStaff();
        allow write: if isOwner(userId) || isStaff();
      }
    }

    // Transactional Mail Queue for Firebase Trigger Email Extension
    match /mail/{mailId} {
      allow read, create: if true;
      allow update, delete: if isStaff() || isAdmin();
    }

    // Homepage Banners: Public read, admin and staff write
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // Category Management & Images: Public read, admin and staff write
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // Seller Bonuses: Public/sellers can read, write restricted to platform admin/staff
    match /seller_bonuses/{sellerId} {
      allow read: if isStaff() || (isSeller() && sellerId == request.auth.uid);
      allow write: if isStaff() || isAdmin();
    }

    // =========================================================================
    // IMMUTABLE ACTIVITY LOGS (AUDIT TRAIL)
    // - Read: Accessible for Admin Portal audit querying
    // - Create: Append-only log recording for admin/seller mutations
    // - Update & Delete: STRICTLY FORBIDDEN (Append-only & completely immutable)
    // =========================================================================
    match /activity_logs/{logId} {
      allow read: if isStaff();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }

    match /users/{userId}/private/{documentId} {
      allow read, write: if isOwner(userId);
    }

    match /search_analytics/{recordId} {
      allow read: if isStaff();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }
  }
}
