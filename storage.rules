rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'aryangandhale27@gmail.com' ||
        request.auth.token.email == 'admin@semixlabs.com' ||
        request.auth.token.email == 'admin@rietzz.com' ||
        request.auth.token.email == 'admin@semix.com' ||
        firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid)) ||
        (firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
         firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isCatalogManager() {
      return isAdmin() || (isSignedIn() &&
        firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['team']);
    }

    match /products/{productId}/{fileName} {
      allow read: if true;
      allow create, update: if isCatalogManager() &&
        request.resource.contentType.matches('image/.*') &&
        request.resource.size < 10 * 1024 * 1024;
      allow delete: if isCatalogManager();
    }

    match /banners/{bannerId}/{fileName} {
      allow read: if true;
      allow create, update: if isCatalogManager() &&
        request.resource.contentType.matches('image/.*') &&
        request.resource.size < 10 * 1024 * 1024;
      allow delete: if isCatalogManager();
    }

    match /categories/{categoryId}/{fileName} {
      allow read: if true;
      allow create, update: if isCatalogManager() &&
        request.resource.contentType.matches('image/.*') &&
        request.resource.size < 10 * 1024 * 1024;
      allow delete: if isCatalogManager();
    }

    match /orders/{orderId}/{fileName} {
      allow read: if isAdmin() || (
        isSignedIn() &&
        firestore.exists(/databases/(default)/documents/orders/$(orderId)) &&
        firestore.get(/databases/(default)/documents/orders/$(orderId)).data.assignedSellerId == request.auth.uid
      );
      allow create: if isAdmin() &&
        request.resource.contentType.matches('image/.*') &&
        request.resource.size < 10 * 1024 * 1024;
      allow update, delete: if isAdmin();
    }

    match /customer-list-uploads/{requestId}/{fileName} {
      allow read: if isCatalogManager();
      allow create: if request.resource.size > 0 &&
        request.resource.size <= 15 * 1024 * 1024 &&
        (request.resource.contentType.matches('image/.*') ||
         request.resource.contentType in [
           'application/pdf',
           'application/msword',
           'application/vnd.ms-excel',
           'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
           'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
           'application/vnd.oasis.opendocument.text',
           'application/vnd.oasis.opendocument.spreadsheet',
           'text/csv',
           'text/plain',
           'text/tab-separated-values'
         ]);
      allow update, delete: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
