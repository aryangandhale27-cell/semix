rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'aryangandhale27@gmail.com' ||
        firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid)) ||
        (firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
         firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isCatalogManager() {
      return isAdmin() || (isSignedIn() &&
        firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['team']);
    }

    match /products/{productId}/{fileName} {
      allow read: if true;
      allow create, update: if isCatalogManager() &&
        request.resource.contentType.matches('image/.*') &&
        request.resource.size < 10 * 1024 * 1024;
      allow delete: if isCatalogManager();
    }

    match /banners/{bannerId}/{fileName} {
      allow read: if true;
      allow create, update: if isCatalogManager() &&
        request.resource.contentType.matches('image/.*') &&
        request.resource.size < 10 * 1024 * 1024;
      allow delete: if isCatalogManager();
    }

    match /categories/{categoryId}/{fileName} {
      allow read: if true;
      allow create, update: if isCatalogManager() &&
        request.resource.contentType.matches('image/.*') &&
        request.resource.size < 10 * 1024 * 1024;
      allow delete: if isCatalogManager();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
